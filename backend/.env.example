# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shopsphere?schema=public"

# JWT
JWT_SECRET=your_super_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:5173

# File upload
UPLOAD_DIR=public/uploads

# SMTP (for forgot password emails)
# Use Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
# Use Outlook: SMTP_HOST=smtp.office365.com, SMTP_PORT=587
# Use Mailtrap (testing): SMTP_HOST=smtp.mailtrap.io, SMTP_PORT=2525
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
SMTP_FROM=ShopSphere <noreply@shopsphere.com>
SMTP_SECURE=false

# Frontend URL (used to build password reset links)
APP_URL=http://localhost:5173

# Razorpay (for real payments - leave blank to use mock)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# OTP via SMS / WhatsApp (Twilio) - leave blank to use EMAIL ONLY
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=           # Your Twilio phone number, e.g. +1234567890
TWILIO_WHATSAPP_FROM=          # e.g. whatsapp:+14155238886 (Twilio Sandbox number)

# OTP settings
OTP_TTL_MINUTES=10
OTP_CHANNEL=EMAIL              # EMAIL | SMS | WHATSAPP  (default channel for new OTPs)
OTP_REQUIRE_FOR_REGISTER=true  # If true, users must verify OTP before account activation

